# Database
# Use DATABASE_URL for Supabase or any managed PostgreSQL instance.
# For local PostgreSQL, keep the individual DB_* values below.
DATABASE_URL=
SUPABASE_DATABASE_URL=
POSTGRES_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=saas_platform
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# API
PORT=5000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000
